<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AetherCurrentUnlocker.LocalizationTests</AssemblyName>
    <NuGetAudit>false</NuGetAudit>
    <DalamudLibPath Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(appdata)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AetherCurrentUnlocker\AetherCurrentUnlocker.csproj" />
    <Reference Include="Dalamud" HintPath="$(DalamudLibPath)Dalamud.dll" Private="True" />
    <Reference Include="Newtonsoft.Json" HintPath="$(DalamudLibPath)Newtonsoft.Json.dll" Private="True" />
  </ItemGroup>
</Project>
